{
  "name": "drupify",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:backend",
    "dev:web": "npm --workspace=web run dev",
    "dev:backend": "npm --workspace=backend run start:dev",
    "build": "npm-run-all build:web build:backend",
    "build:web": "npm --workspace=web run build",
    "build:backend": "npm --workspace=backend run build"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
